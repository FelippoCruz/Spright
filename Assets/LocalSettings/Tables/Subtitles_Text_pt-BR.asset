  m_SharedData: {fileID: 11400000, guid: b9611729093956c448f4bc2a4ce861f8, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 17390940160
    m_Localized: "Estas\u2026 s\xE3o algumas manifesta\xE7\xF5es dos seus pensamentos
      negativos."
    m_Metadata:
      m_Items: []
  - m_Id: 43081052160
    m_Localized: "Eles n\xE3o s\xE3o a fonte dos seus problemas, mas n\xE3o faria
      mal lidar com eles."
    m_Metadata:
      m_Items: []
  - m_Id: 51410939904
    m_Localized: "Isso ir\xE1 te ajudar em alguns aspectos da sua jornada, confian\xE7a
      sendo um dos mais importantes\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 23091374678388736
    m_Localized: "\rVoc\xEA ainda acha que h\xE1 uma sa\xEDda, n\xE3o \xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 23586073869037568
    m_Localized: "Voc\xEA continua se movendo... como se o ch\xE3o fosse levar a
      um novo lugar."
    m_Metadata:
      m_Items: []
  - m_Id: 38492896257945600
    m_Localized: "Mas \xE9 sempre a mesma coisa.\r\nAs mesmas paredes. O mesmo peso.\r\nVoc\xEA
      luta, cai e chama isso de progresso."
    m_Metadata:
      m_Items: []
  - m_Id: 38492931263606784
    m_Localized: "Talvez voc\xEA caminhe s\xF3 para esquecer que est\xE1 perdido."
    m_Metadata:
      m_Items: []
  references:
    version: 2
